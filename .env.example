# Copy this file to `.env` and fill in real values before running
# docker-compose.prod.yml. Never commit the real `.env` file.

# Long random string used to sign login session tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Postgres password for the app's database user.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# pgAdmin login (the web GUI for browsing the database).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# From Google Cloud Console > APIs & Services > Credentials, an OAuth
# client of type "Web application". Redirect URI must exactly match one
# registered there, e.g. https://yourdomain.com/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# From developers.facebook.com > your app > Settings > Basic, with the
# Facebook Login product added and this same URL listed under its Valid
# OAuth Redirect URIs, e.g. https://yourdomain.com/api/auth/facebook/callback.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

FRONTEND_URL=

# From resend.com, for password-reset and verification emails.
RESEND_API_KEY=
EMAIL_FROM=

# From Cloudflare dashboard > R2 Object Storage > Manage API tokens.
# R2_ACCOUNT_ID is the subdomain in the endpoint URL:
# https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
